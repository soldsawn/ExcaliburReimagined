<UserControl x:Class="Excalibur.App.Ui.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Excalibur.App.Ui.Controls">
    <StackPanel>
        <TextBlock Text="Panel" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,18" />

        <!-- fault banner -->
        <Border x:Name="FaultBanner" Style="{StaticResource CardBox}" BorderBrush="{DynamicResource Bad}" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ClearFault" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Tekrar dene" />
                <StackPanel>
                    <TextBlock Text="Fanlarda bir sorun oldu" Style="{StaticResource CardTitle}" Foreground="{DynamicResource Bad}" />
                    <TextBlock Text="Uygulama fan bilgilerini güvenle okuyamadı, bu yüzden fanları orijinal ayara bıraktı. &quot;Tekrar dene&quot; ile yeniden başlatabilirsiniz."
                               Style="{StaticResource Caption}" Margin="0,4,12,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- unknown fan firmware: monitor only, the user may try it -->
        <Border x:Name="TrialBanner" Style="{StaticResource CardBox}" BorderBrush="{DynamicResource Warn}" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyInfo" Style="{StaticResource PlainButton}" Content="Bilgileri kopyala" />
                    <Button x:Name="StartTrial" Style="{StaticResource AccentButton}" Content="Dene" Margin="8,0,0,0" />
                    <Button x:Name="CloseTrial" Style="{StaticResource PlainButton}" Content="Kapat" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TrialTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="TrialText" Style="{StaticResource Caption}" Margin="0,4,12,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CPU / GPU -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:BracketCard Style="{StaticResource CardBox}" Padding="20,16,20,18">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="İŞLEMCİ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubText}" />
                        <TextBlock x:Name="CpuName" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock x:Name="CpuTemp" Style="{StaticResource BigValue}" Text="–" Margin="0,6,0,0" />
                    <DockPanel Margin="0,4,0,10">
                        <TextBlock x:Name="CpuFan" Style="{StaticResource Mono}" Text="–" />
                        <TextBlock x:Name="CpuDuty" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <c:BlockBar x:Name="CpuBar" Height="8" Fill="{DynamicResource Value}" Empty="{DynamicResource CardHover}" />
                </StackPanel>
            </c:BracketCard>
            <c:BracketCard Grid.Column="2" Style="{StaticResource CardBox}" Padding="20,16,20,18">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="EKRAN KARTI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubText}" />
                        <TextBlock x:Name="GpuName" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock x:Name="GpuTemp" Style="{StaticResource BigValue}" Text="–" Margin="0,6,0,0" />
                    <DockPanel Margin="0,4,0,10">
                        <TextBlock x:Name="GpuFan" Style="{StaticResource Mono}" Text="–" />
                        <TextBlock x:Name="GpuDuty" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <c:BlockBar x:Name="GpuBar" Height="8" Fill="{DynamicResource Value}" Empty="{DynamicResource CardHover}" />
                </StackPanel>
            </c:BracketCard>
        </Grid>

        <!-- power at a glance -->
        <UniformGrid x:Name="Stats" Columns="3" Margin="0,14,0,0" />

        <!-- fan profile and power mode side by side: the two choices made most often -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="Fan profili" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="ProfileHint" Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                    <ContentControl x:Name="ProfileHost" Focusable="False" />
                    <TextBlock x:Name="ProfileError" Style="{StaticResource Caption}" Foreground="{DynamicResource Bad}" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock Text="Güç modu" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="PowerHint" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                    <WrapPanel x:Name="PowerButtons" />
                    <TextBlock x:Name="PowerError" Style="{StaticResource Caption}" Foreground="{DynamicResource Bad}" Visibility="Collapsed" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- facts -->
        <Border Style="{StaticResource CardBox}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Sistem" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                <UniformGrid x:Name="Facts" Columns="4" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

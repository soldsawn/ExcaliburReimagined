<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux version (L1, .scratch/linux/spec.md): the fan service and the `excalibur-reimagined` command (short alias `exr` when free), built from Excalibur.Core's
       portable sources (linked, not copied) plus a Linux hardware layer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>excalibur-reimagined</AssemblyName>
    <RootNamespace>Excalibur.Linux</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Core's shared sources leave their Windows-only parts out under LINUX. -->
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    <!-- EcTrace (Windows event log) is linked but never started on Linux. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- EcTrace watches the Windows event log; on Linux it is linked but never started. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.0" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Excalibur.App\Assets\app-256.png" LogicalName="app-256.png" />
    <!-- The window's fonts (open licences in Ui/Fonts) and theme. -->
    <AvaloniaResource Include="Ui\Fonts\*.ttf" />
    <AvaloniaResource Include="Ui\Theme.axaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows window's plain-C# parts, shared so both windows word things the same way. -->
    <Compile Include="..\Excalibur.App\Texts.cs;..\Excalibur.App\ProfileCatalog.cs;..\Excalibur.App\Tray\ProfileNames.cs;..\Excalibur.App\SystemEventLog.cs" Link="App\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <CoreWindowsOnly Include="..\Excalibur.Core\Battery\WmiBatteryHardware.cs" />
    <CoreWindowsOnly Include="..\Excalibur.Core\Fan\EcFanHardware.cs;..\Excalibur.Core\Hardware\EmbeddedController.cs" />
    <CoreWindowsOnly Include="..\Excalibur.Core\Hardware\GmWmiGateway.cs;..\Excalibur.Core\Hardware\PawnIoCpuPowerRegisters.cs;..\Excalibur.Core\Hardware\PawnIoSession.cs;..\Excalibur.Core\Power\EcPowerHardware.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything in Core except the Windows hardware layer (PawnIO, WMI, Windows' battery and power APIs). -->
    <Compile Include="..\Excalibur.Core\**\*.cs" Exclude="..\Excalibur.Core\obj\**;..\Excalibur.Core\bin\**;@(CoreWindowsOnly)" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

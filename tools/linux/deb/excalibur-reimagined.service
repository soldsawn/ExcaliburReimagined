[Unit]
Description=Excalibur Reimagined fan control
After=systemd-modules-load.service

[Service]
ExecStart=/opt/excalibur-reimagined/excalibur-reimagined service
# Servis durunca ya da çökünce fanlar dizüstünün kendi ayarına döner.
ExecStopPost=/opt/excalibur-reimagined/excalibur-reimagined release
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

#!/bin/sh
# Before the files go (remove) or are replaced (upgrade): stop the service, which hands the fans to the EC
# (ExecStopPost runs "release" as well).
set -e
APP=excalibur-reimagined
if [ -d /run/systemd/system ]; then
  systemctl stop $APP.service 2>/dev/null || true
  [ "$1" = remove ] && systemctl disable $APP.service >/dev/null 2>&1 || true
fi
[ -x /opt/$APP/$APP ] && /opt/$APP/$APP release 2>/dev/null || true
# This version's module (an upgrade's postinst adds its own).
modprobe -r excalibur_ec 2>/dev/null || true
command -v dkms >/dev/null 2>&1 && dkms remove -m excalibur-ec -v @VERSION@ --all >/dev/null 2>&1 || true
exit 0
